# Modelo de configuração local — copie para `.env` e ajuste. Nenhum valor
# aqui é segredo real; credencial de corretora NUNCA entra em `.env` (ADR-0009).
# Os valores abaixo são os defaults do código / docker-compose.local.yml.
#
# O projeto não carrega `.env` sozinho: o uv carrega quando UV_ENV_FILE=.env
# (variável de usuário) ou com `uv run --env-file .env ...`. Edite os valores
# no lugar — não acrescente a mesma variável de novo no fim: com duplicatas,
# o uv usa a PRIMEIRA ocorrência e ignora as seguintes.

# --- Portas publicadas pelo docker-compose.local.yml --------------------------
# Mude se 5432/6379 já estiverem ocupadas no host (ver infrastructure/README.md)
# e ajuste a porta nos DSNs abaixo.
QUANT_PG_PORT=5432
QUANT_REDIS_PORT=6379

# --- Aplicação (dev) ---------------------------------------------------------
MARKET_DATA_LAKE_PG_DSN=postgresql://quant:quant@localhost:5432/quant_platform
MARKET_DATA_LAKE_DUCKDB_PATH=data/market_data_lake.duckdb
# Cache dos arquivos anuais do COTAHIST (source="cotahist"); data/ é ignorado pelo git.
MARKET_DATA_LAKE_COTAHIST_DIR=data/raw/cotahist
FEATURE_STORE_REDIS_URL=redis://localhost:6379/0
RISK_ENGINE_PG_DSN=postgresql://quant:quant@localhost:5432/quant_platform
# Só necessária para source="alpha_vantage"; testes usam o provider mock.
ALPHA_VANTAGE_API_KEY=

# --- Testes ------------------------------------------------------------------
# Variáveis próprias da suíte: os testes ignoram as da aplicação acima, então
# nunca apagam dados de dev. O banco precisa terminar em `_test`.
QUANT_TEST_PG_DSN=postgresql://quant:quant@localhost:5432/quant_platform_test
QUANT_TEST_REDIS_URL=redis://localhost:6379/15
# 1 = infra indisponível falha a suíte em vez de pular (padrão no CI).
QUANT_REQUIRE_INTEGRATION=0
