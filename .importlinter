[importlinter]
root_packages =
    market_data_lake
    feature_store
    risk_engine
    trading_api
    backtesting_engine

[importlinter:contract:market-data-lake-layers]
name = market-data-lake: domain não conhece application/infrastructure/api
type = layers
layers =
    market_data_lake.api
    market_data_lake.infrastructure
    market_data_lake.application
    market_data_lake.domain

[importlinter:contract:feature-store-layers]
name = feature-store: domain não conhece application/infrastructure/api
type = layers
layers =
    feature_store.api
    feature_store.infrastructure
    feature_store.application
    feature_store.domain

[importlinter:contract:feature-store-so-usa-market-data-lake-api]
name = feature-store só pode importar market_data_lake.api (nunca domain/application/infrastructure)
type = forbidden
source_modules =
    feature_store
forbidden_modules =
    market_data_lake.domain
    market_data_lake.application
    market_data_lake.infrastructure
# market_data_lake.api importa domain/application/infrastructure internamente
# para se montar (é a fachada) — isso não deve contar como violação de
# feature_store, só o import direto conta.
allow_indirect_imports = True

[importlinter:contract:risk-engine-layers]
name = risk-engine: domain não conhece application/infrastructure/api
type = layers
layers =
    risk_engine.api
    risk_engine.infrastructure
    risk_engine.application
    risk_engine.domain

[importlinter:contract:risk-engine-so-usa-market-data-lake-api]
name = risk-engine só pode importar market_data_lake.api (nunca domain/application/infrastructure)
type = forbidden
source_modules =
    risk_engine
forbidden_modules =
    market_data_lake.domain
    market_data_lake.application
    market_data_lake.infrastructure
allow_indirect_imports = True

[importlinter:contract:trading-api-layers]
name = trading-api: domain não conhece infrastructure (nem application/api, quando existirem)
type = layers
layers =
    trading_api.infrastructure
    trading_api.domain
# Ainda não há trading_api.application/api nesta fatia (só o port de
# corretora, ver trading-api/docs/spec.md) — adicionar ao contrato quando
# a camada de orquestração (kill switch, idempotência, reconciliação)
# for implementada.

[importlinter:contract:backtesting-engine-layers]
name = backtesting-engine: domain não conhece application/api
type = layers
layers =
    backtesting_engine.api
    backtesting_engine.application
    backtesting_engine.domain

[importlinter:contract:backtesting-engine-so-usa-apis-publicas]
name = backtesting-engine só importa feature_store.api, market_data_lake.api e risk_engine.api
type = forbidden
source_modules =
    backtesting_engine
forbidden_modules =
    feature_store.domain
    feature_store.application
    feature_store.infrastructure
    market_data_lake.domain
    market_data_lake.application
    market_data_lake.infrastructure
    risk_engine.domain
    risk_engine.application
    risk_engine.infrastructure
allow_indirect_imports = True
